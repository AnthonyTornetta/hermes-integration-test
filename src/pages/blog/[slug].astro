---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
	return [
		{ params: { slug: 'hello-world' } },
		{ params: { slug: 'astro-basics' } },
		{ params: { slug: 'markdown' } },
	];
}

const { slug } = Astro.params;
---

<Layout title={slug}>
	<h1>{slug}</h1>
	<p>Dynamic route rendered at build time.</p>
	<a href="/">Back home</a>
</Layout>
