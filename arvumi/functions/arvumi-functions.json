{
  "version": 1,
  "runtime": "python",
  "routes": [
    {
      "path": "/api/cron",
      "entrypoint": "cron.py",
      "env": [
        "CRON_SECRET"
      ],
      "settings": {
        "max_concurrency": 1
      }
    },
    {
      "path": "/api/unrelated",
      "entrypoint": "unrelated.py",
      "env": []
    }
  ]
}
