{
  "version": 1,
  "runtime": "node",
  "routes": [
    {
      "path": "/api/stream",
      "entrypoint": "stream.cjs",
      "env": [
        "CRON_SECRET"
      ],
      "settings": {
        "max_concurrency": 1,
        "timeout_seconds": 4,
        "cpu_millis": 500,
        "memory_mib": 256
      }
    }
  ]
}
