{
  "version": 1,
  "runtime": "python",
  "routes": [
    {
      "path": "/api/run",
      "entrypoint": "routing.py",
      "env": [
        "CRON_SECRET"
      ],
      "settings": {
        "max_concurrency": 1,
        "timeout_seconds": 8,
        "cpu_millis": 500,
        "memory_mib": 256
      }
    },
    {
      "path": "/api/projects",
      "entrypoint": "routing.py",
      "env": [
        "CRON_SECRET"
      ],
      "settings": {
        "max_concurrency": 1,
        "timeout_seconds": 8,
        "cpu_millis": 500,
        "memory_mib": 256
      }
    },
    {
      "path": "/api/cron",
      "entrypoint": "routing.py",
      "env": [
        "CRON_SECRET"
      ],
      "settings": {
        "max_concurrency": 1,
        "timeout_seconds": 8,
        "cpu_millis": 500,
        "memory_mib": 256
      }
    }
  ]
}
